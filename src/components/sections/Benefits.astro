---
import { BrainCircuit, Cpu, Code2, Gift } from "lucide-react";
import BenefitCard from "../ui/cards/BenefitCard.astro";

const benefitsData = [
  {
    title: "UPSTREAM AI SEMINAR",
    description:
      "Pelajari implementasi mendalam NLP dan LLM langsung dari praktisi industri. Kita akan mengupas tuntas optimasi sistem cerdas melampaui sekadar wrapping API biasa.",
    icon: BrainCircuit,
    colSpan: "md:col-span-2",
    isHighlight: false,
  },
  {
    title: "TEALINUXOS NEW RELEASE",
    description:
      "Jadi yang pertama mencoba distribusi Linux racikan DOSCOM versi terbaru yang kini dilengkapi dengan integrasi AI add-ons siap pakai.",
    icon: Cpu,
    colSpan: "md:col-span-1",
    isHighlight: true, // HIGHLIGHT UTAMA UNTUK ACARA RELEASE PARTY
    buttonText: "Daftar Sekarang",
    buttonHref: "https://d-form.doscom.org",
  },
  {
    title: "EXPO PROJECT SHOWCASE",
    description:
      "Eksplorasi langsung proyek open source hasil kembangan satu periode internal DOSCOM seperti D-Form, Sicon C2 framework, hingga web profile terbaru.",
    icon: Code2,
    colSpan: "md:col-span-1",
    isHighlight: false,
  },
  {
    title: "EXCLUSIVE KIT & MERCHANDISE",
    description:
      "Bawa pulang bundle merchandise eksklusif TeaLinuxOS, sertifikat penghargaan resmi berskala regional, serta konsumsi premium selama acara berlangsung.",
    icon: Gift,
    colSpan: "md:col-span-2",
    isHighlight: false,
  },
];
---

<section id="benefit" class="bg-surface-lowest py-32">
  <div class="mb-20 text-center">
    <h2
      class="font-display text-on-surface text-4xl font-bold tracking-tighter uppercase md:text-5xl lg:text-6xl"
    >
      Kenapa Harus <span class="text-primary text-shadow-glow italic">Ikut</span>
    </h2>
  </div>
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {benefitsData.map((benefit) => <BenefitCard {...benefit} />)}
    </div>
  </div>
</section>

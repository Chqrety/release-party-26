---
import TicketCard from "../ui/TicketCard.astro";
import { Zap, Ticket, Users } from "lucide-react"; // Ikon untuk representasi tiket

export const ticketsData = [
  {
    title: "Tiket Single UDINUS",
    price: "35K",
    features: [
      "Akses Penuh Seminar & Expo Project",
      "Sertifikat Digital & Standard Kit",
      "Stiker Eksklusif TeaLinuxOS",
      "Khusus Mahasiswa Aktif UDINUS",
      "Slot Kursi Prioritas",
    ],

    isHighlight: false,
    icon: Ticket,
  },
  {
    title: "Tiket Bundling (3 Peserta)",
    price: "100K",
    features: [
      "3x Akses Penuh Seminar & Expo",
      "3x Sertifikat & Seminar Kit",
      "3x Snack & Coffee Break",
      "Hemat Rp20.000,- dari Harga Normal",
    ],
    isHighlight: true, // Gelap / Standar
    icon: Users,
  },
  {
    title: "Tiket Single Umum",
    price: "40K",
    features: [
      "Akses Penuh Seminar & Expo Project",
      "Sertifikat Digital Resmi",
      "Standard Seminar Kit",
      "Snack & Coffee Break",
      "Terbuka untuk Publik / Umum",
    ],
    isHighlight: false, // Gelap / Standar
    icon: Zap,
  },
];
---

<section id="tickets" class="bg-surface-lowest relative overflow-hidden py-32">
  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mb-20 text-center">
      <h2
        class="font-display text-on-surface text-4xl font-bold tracking-tighter uppercase md:text-5xl lg:text-6xl"
      >
        SECURE YOUR <span class="text-primary text-shadow-glow italic">SPOT</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:items-center lg:gap-8">
      {ticketsData.map((ticket) => <TicketCard {...ticket} />)}
    </div>
  </div>
</section>
